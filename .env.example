# Frontend environment — copy to .env.local and adjust.
# Nothing here is secret; all values are inlined into the public bundle.

# Base path for the REST API, relative so the Vite dev proxy (or a reverse
# proxy in production) handles the origin. Backend serves /api/v1.
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api requests. Ignored at build time.
VITE_PROXY_TARGET=http://localhost:3000

# Dev server port.
VITE_PORT=5173
